# Copy this file to .env and adjust as needed. All values are optional —
# HumanLens runs with sensible defaults if .env doesn't exist.

# --- Storage ---
HUMANLENS_DB_PATH=app/humanlens.db
HUMANLENS_MODEL_DIR=app/models

# --- Analysis limits ---
HUMANLENS_MIN_WORDS=40
HUMANLENS_MAX_CHARS=50000

# --- Detector ---
HUMANLENS_SENSITIVITY=0.5

# --- Privacy ---
# Set to false to store only short previews in history, not full text.
HUMANLENS_STORE_FULL_TEXT=true

# --- Optional local LLM (Ollama) ---
HUMANLENS_OLLAMA_ENABLED=false
HUMANLENS_OLLAMA_HOST=http://localhost:11434
HUMANLENS_OLLAMA_MODEL=llama3.1
HUMANLENS_OLLAMA_TIMEOUT=30

# --- API ---
HUMANLENS_API_HOST=127.0.0.1
HUMANLENS_API_PORT=8000
